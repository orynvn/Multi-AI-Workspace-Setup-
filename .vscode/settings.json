{
  // ─── Copilot customization ──────────────────────────────────────────────────
  // Defaults already discover: .github/agents, .github/instructions, .github/prompts,
  // .github/hooks, .github/skills, .claude/skills, .agents/skills — no need to list them.

  // Copilot also discovers .claude/agents by default. Claude Code agents share names
  // with the Copilot agents in .github/agents (planner, implementer, debugger, quick...),
  // so hide them to avoid duplicates in the agent picker.
  "chat.agentFilesLocations": {
    ".claude/agents": false
  },

  // CLAUDE.md is the Claude Code adapter. Copilot uses .github/copilot-instructions.md;
  // don't stack both into the same Copilot session (Local harness).
  "chat.useClaudeMdFile": false,

  // Allow subagents to call subagents (Local harness only, max depth 5)
  "chat.subagents.allowInvocationsFromSubagents": true,

  // ─── MCP Servers ────────────────────────────────────────────────────────────
  // Config in .vscode/mcp.json (auto-discovered by VS Code).
  // To let an MCP server use sampling, run "MCP: List Servers > Configure Model Access"
  // and let VS Code write the chat.mcp.serverSampling entry (don't hand-write the key).

  // ─── Editor ─────────────────────────────────────────────────────────────────
  "editor.formatOnSave": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true

  // ─── Recommended extensions ──────────────────────────────────────────────────
  // See .vscode/extensions.json
}
